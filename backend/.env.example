# Copy this file to .env and fill in real values.
# .env is ignored by Git and must never be committed.

DJANGO_SECRET_KEY=your_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Neon (Lakebase Postgres). Copy both from the Neon console.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require&channel_binding=require"
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# Alternative: a local PostgreSQL server. Used only when DATABASE_URL is unset.
# DB_NAME=syntaxtime
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432

# Brevo sends the registration verification email.
# Create the key at Brevo > SMTP & API > API Keys, and verify the sender
# address at Brevo > Senders before using it here.
# The key is a password: keep it in .env only. It must never reach the React
# frontend, a URL, an API response, or Git.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SyntaxTime

# Where password reset links should point. This is the React application, not
# Django: the reset screen lives in the frontend.
# Development: http://localhost:5180
# Production:  https://your-production-domain.com
FRONTEND_URL=http://localhost:5180

# The deployed web frontend's origin, so the browser is allowed to call this
# API. Only needed once the React app is hosted somewhere; leave empty locally,
# because the dev server and the desktop application are already allowed.
# Comma-separated, each with its scheme and no trailing slash:
#   CORS_ALLOWED_ORIGINS=https://syntaxtime.vercel.app
CORS_ALLOWED_ORIGINS=

# The AI focus coach, which answers a pause or a finish with a sentence or two.
# Like the Brevo key, this is a password: backend only, never in the frontend,
# a URL, a response or Git. With it empty the coach answers with its own
# fallback message and pausing and finishing carry on working normally.
AI_API_KEY=
# Which provider answers: groq or anthropic. Groq has a free tier and is very
# fast, which is what this feature needs. Get a key at console.groq.com.
AI_PROVIDER=groq
# Optional. Left empty, a sensible default for the provider above is used.
# Model names change; check the provider's own list if a request starts failing.
#   groq       openai/gpt-oss-120b
#   anthropic  claude-haiku-4-5-20251001
AI_MODEL=groq/compound
