{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SyntaxTime",
  "version": "0.1.0",
  "identifier": "com.syntaxtime.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SyntaxTime",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true
      },
      {
        "label": "focus",
        "title": "SyntaxTime Focus",
        "url": "/focus-window.html",
        "width": 300,
        "height": 360,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "decorations": false,
        "visible": false,
        "focus": false,
        "minWidth": 240,
        "minHeight": 210,
        "maxWidth": 560,
        "maxHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
